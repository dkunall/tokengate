    },
    {
      "name": "Metering",
      "item": [
        {
          "name": "Prices (BILLING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"versioned prices present\", () => pm.expect(pm.response.json()[0]).to.have.property(\"effective_from\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{billingToken}}"
              }
            ],
            "url": {
              "raw": "{{meteringUrl}}/admin/prices",
              "host": [
                "{{meteringUrl}}"
              ],
              "path": [
                "admin",
                "prices"
              ]
            }
          }
        },
        {
          "name": "Usage for the tenant (waits for Kafka)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"requests aggregated\", () => pm.expect(pm.response.json().days.reduce((n, d) => n + d.requests, 0)).to.be.at.least(3));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"today\", new Date().toISOString().slice(0, 10));",
                  "setTimeout(() => {}, 3000);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{billingToken}}"
              }
            ],
            "url": {
              "raw": "{{meteringUrl}}/admin/usage/{{tenantId}}?from={{today}}&to={{today}}",
              "host": [
                "{{meteringUrl}}"
              ],
              "path": [
                "admin",
                "usage",
                "{{tenantId}}?from={{today}}&to={{today}}"
              ]
            }
          }
        },
        {
          "name": "Generate invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"draft with lines\", () => { const i = pm.response.json(); pm.expect(i.status).to.eql(\"DRAFT\"); pm.expect(i.lines.length).to.be.above(0); });"
                ]
