                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Budget snapshot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"tokens counted\", () => pm.expect(pm.response.json().tokens_used_today).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/admin/tenants/{{tenantId}}/budget",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "admin",
                "tenants",
                "{{tenantId}}",
                "budget"
              ]
            }
          }
        },
        {
          "name": "Providers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"mock providers listed\", () => pm.expect(pm.response.json().map(p => p.id)).to.include.members([\"mock-alpha\", \"mock-beta\"]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{viewerToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/admin/providers",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "admin",
                "providers"
              ]
            }
          }
        },
