{
  "uid": "tokengate-overview",
  "title": "TokenGate overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "tokengate"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by route and status",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{application=\"tokengate-gateway\", uri=~\"/v1/.*\"}[1m]))",
          "legendFormat": "{{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Gateway p50 / p95 / p99 (non-streaming)",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"tokengate-gateway\", uri=\"/v1/chat/completions\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"tokengate-gateway\", uri=\"/v1/chat/completions\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"tokengate-gateway\", uri=\"/v1/chat/completions\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Provider latency p95 by provider",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(tokengate_provider_latency_seconds_bucket[1m])))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Provider calls by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "sum by (provider, outcome) (rate(tokengate_provider_latency_seconds_count[1m]))",
          "legendFormat": "{{provider}} {{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache hit ratio by tier",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "sum by (tier) (rate(tokengate_cache_lookups_total{result=\"hit\"}[5m])) / sum by (tier) (rate(tokengate_cache_lookups_total[5m]))",
          "legendFormat": "{{tier}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rejections by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "sum by (reason) (rate(tokengate_rejections_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Circuit breaker state (0 closed, 1 half-open, 2 open)",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "max by (provider) (tokengate_breaker_state)",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Failovers",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "sum by (from, to) (increase(tokengate_failovers_total[5m]))",
          "legendFormat": "{{from}} -> {{to}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "PII values masked",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "sum by (type) (increase(tokengate_pii_masked_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tokens per minute by tenant",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "sum by (tenant, type) (rate(tokengate_tokens_total[1m])) * 60",
          "legendFormat": "{{tenant}} {{type}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Spend (USD, gateway estimate) by tenant, last 1h",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "sum by (tenant) (increase(tokengate_cost_usd_total[1h]))",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Streams by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "sum by (outcome) (increase(tokengate_streams_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Usage events: outbox publish failures and metering consumer lag",
      "datasource": {
        "type": "prometheus",
        "uid": "tg-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "sum(increase(tokengate_usage_record_failures_total[5m]))",
          "legendFormat": "record failures"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "tg-prom"
          },
          "expr": "sum(kafka_consumer_fetch_manager_records_lag_max{application=\"tokengate-metering\"})",
          "legendFormat": "consumer lag (max)"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}