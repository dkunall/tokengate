<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.tokengate</groupId>
    <artifactId>tokengate-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>tokengate-parent</name>
    <description>TokenGate: an OpenAI-compatible LLM API gateway</description>

    <modules>
        <module>tokengate-common</module>
        <module>tokengate-arch-rules</module>
        <module>tokengate-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <jtokkit.version>1.1.0</jtokkit.version>
        <onnxruntime.version>1.19.2</onnxruntime.version>
        <springdoc.version>2.6.0</springdoc.version>
        <logstash-logback.version>7.4</logstash-logback.version>
        <archunit.version>1.3.0</archunit.version>
        <wiremock.version>3.9.1</wiremock.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.tokengate</groupId><artifactId>tokengate-common</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.tokengate</groupId><artifactId>tokengate-arch-rules</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.knuddels</groupId><artifactId>jtokkit</artifactId><version>${jtokkit.version}</version></dependency>
            <dependency><groupId>com.microsoft.onnxruntime</groupId><artifactId>onnxruntime</artifactId><version>${onnxruntime.version}</version></dependency>
            <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId><version>${springdoc.version}</version></dependency>
            <dependency><groupId>net.logstash.logback</groupId><artifactId>logstash-logback-encoder</artifactId><version>${logstash-logback.version}</version></dependency>
            <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><version>${archunit.version}</version></dependency>
            <dependency><groupId>org.wiremock</groupId><artifactId>wiremock-standalone</artifactId><version>${wiremock.version}</version></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <trimStackTrace>false</trimStackTrace>
                        <!-- the box running this has ~2 GB free; keep forks small -->
                        <argLine>-Xmx512m -XX:+UseSerialGC</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
